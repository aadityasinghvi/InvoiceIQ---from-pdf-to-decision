# Streamlit Community Cloud -> your app -> Settings -> Secrets. Paste these lines there
# with your real values. Never put real values in this file (it is published on GitHub).

# AI provider used for extraction (this project is tested on Groq's free tier)
LLM_PROVIDER = "groq"
GROQ_API_KEY = "gsk_your-groq-key"
GROQ_MODEL = "openai/gpt-oss-120b"

# Optional fallback: switch LLM_PROVIDER to "gemini" to use it
# GEMINI_API_KEY = "your-gemini-key"
# GEMINI_MODEL = "gemini-3.8-flash"

# Hosted database (Supabase -> Connect -> Session pooler URI, with your password)
DATABASE_URL = "postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Protects approve / reject / release / reset on the public app
REVIEWER_PASSCODE = "choose-a-passcode"
