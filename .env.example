# Copy to .env and fill in your Groq key. Never commit .env.
# This project uses Groq (free tier).
LLM_PROVIDER=groq

# Groq key from https://console.groq.com/keys
GROQ_API_KEY=paste-your-groq-key-here
GROQ_MODEL=openai/gpt-oss-120b

# Optional fallback (set LLM_PROVIDER=gemini to use): https://aistudio.google.com/apikey
# GEMINI_API_KEY=paste-your-gemini-key-here
# GEMINI_MODEL=gemini-3.8-flash
# How hard Gemini 3 'thinks' before answering: minimal, low (default), medium, high
# GEMINI_THINKING_LEVEL=low

# Option B: OpenAI key (paid). Uncomment both lines to use it instead.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4.1-mini

# If more than one key is set, choose explicitly: gemini, groq or openai
# LLM_PROVIDER=gemini

# Leave unset for a local SQLite file (data/invoiceiq.db).
# For the hosted demo use Postgres, e.g. Supabase "Session pooler" connection string:
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Optional locally, recommended on the hosted app: protects approve/reject/release/reset.
# REVIEWER_PASSCODE=choose-a-passcode
